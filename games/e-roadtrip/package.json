{
  "name": "e-roadtrip",
  "version": "0.6.0",
  "private": true,
  "description": "e-Roadtrip: Pixel Europe – pixel-art EV roadtrip planning and top-down driving game (Phaser 3 + TypeScript)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "build:geo": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-europe-geo.mjs",
    "test": "node tests/run.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "phaser": "^3.88.2",
    "typescript": "^5.7.2"
  }
}
