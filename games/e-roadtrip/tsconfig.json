{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "typeRoots": [
      "/tmp/eroadtrip-build/node_modules",
      "/tmp/eroadtrip-build/node_modules/phaser/types"
    ]
  },
  "include": ["src/**/*.ts"]
}
